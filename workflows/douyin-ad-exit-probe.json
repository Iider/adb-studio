{
  "schema_version": 1,
  "id": "douyin-ad-exit-probe",
  "name": "抖音极速版 · 广告结束检查",
  "description": "确认当前为广告直播间，由工作台点击右上角关闭并保存返回页面。",
  "devices": ["3430131496001EB"],
  "entry": "check_ad",
  "model_limit": 0,
  "nodes": [
    {"id": "check_ad", "label": "确认当前是广告直播间", "type": "branch", "guard": "风云", "cases": [{"contains": "基础展馆", "next": "tap_close"}], "otherwise": "needs_help"},
    {"id": "tap_close", "label": "关闭广告直播间", "type": "fixed_tap_loop", "x": 1014, "y": 193, "count": 1, "interval": 1, "next": "wait_result"},
    {"id": "wait_result", "label": "等待返回页面", "type": "wait", "seconds": 3, "next": "done"},
    {"id": "done", "label": "保存广告结果", "type": "end", "result": "succeeded"},
    {"id": "needs_help", "label": "当前页面不符，停止点击", "type": "end", "result": "needs_help"}
  ],
  "tests": [
    {"node": "check_ad", "text": "风云 基础展馆", "expected": "tap_close"},
    {"node": "check_ad", "text": "风云 其他信息", "expected": "needs_help"},
    {"node": "check_ad", "text": "必应 Rewards", "expected": "unknown"},
    {"node": "tap_close", "text": "x=1014,y=193", "expected": "valid"}
  ]
}
