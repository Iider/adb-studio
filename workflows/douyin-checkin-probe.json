{
  "schema_version": 1,
  "id": "douyin-checkin-probe",
  "version": 1,
  "name": "抖音极速版 · 天天领金币入口试跑",
  "description": "从已打开的赚钱任务日常任务区域，识别天天领金币并由工作台点击一次，保存点击后画面。",
  "devices": ["3430131496001EB"],
  "entry": "check_page",
  "model_limit": 0,
  "nodes": [
    {"id": "check_page", "label": "确认天天领金币在当前页面", "type": "branch", "guard": "日常任务", "cases": [{"contains": "天天领金币", "next": "tap_daily"}], "otherwise": "needs_help"},
    {"id": "tap_daily", "label": "点击天天领金币的去领取", "type": "fixed_tap_loop", "x": 927, "y": 1268, "count": 1, "interval": 1, "next": "wait_result"},
    {"id": "wait_result", "label": "等待领取页面", "type": "wait", "seconds": 3, "next": "done"},
    {"id": "done", "label": "保存领取后的画面", "type": "end", "result": "succeeded"},
    {"id": "needs_help", "label": "当前页面不符，停止点击", "type": "end", "result": "needs_help"}
  ],
  "tests": [
    {"node": "check_page", "text": "日常任务 天天领金币 7天签到必拿", "expected": "tap_daily"},
    {"node": "check_page", "text": "日常任务 其他任务", "expected": "needs_help"},
    {"node": "check_page", "text": "必应 Rewards", "expected": "unknown"},
    {"node": "tap_daily", "text": "x=927,y=1268", "expected": "valid"}
  ]
}
